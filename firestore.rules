rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Inquiries Collection Rules
    match /inquiries/{inquiryId} {
      // Anyone can submit an inquiry (Public Write with required fields check)
      allow create: if request.resource.data.keys().hasAll(['fullName', 'email', 'phone', 'service', 'message', 'status'])
                    && request.resource.data.status == 'pending';

      // Only authenticated users/admins can read, update, or delete inquiries
      allow read, update, delete: if isAuthenticated();
    }

    // 2. Consultations Collection Rules
    match /consultations/{consultationId} {
      // Anyone can book a consultation
      allow create: if request.resource.data.keys().hasAll(['fullName', 'email', 'phone', 'preferredTopic', 'status'])
                    && request.resource.data.status == 'scheduled';

      // Authenticated read/update/delete
      allow read, update, delete: if isAuthenticated();
    }
  }
}
